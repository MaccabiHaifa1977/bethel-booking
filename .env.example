# Copy to .env (local) or add as Variables in Railway.

# Database (Railway: add a PostgreSQL service and reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:password@localhost:5432/bethel_booking
PORT=3470

# The public address of the site, used in e-mails and receipts (no trailing slash)
PUBLIC_URL=https://www.bethel-hostel.com

# Admin panel (/admin) password - use a long random password in production
ADMIN_PASSWORD=
# Any long random string (keeps admins logged in across restarts)
SESSION_SECRET=

# true = guests can finish a booking with a fake "demo payment" while PayPal is not connected.
# NEVER leave this on in production.
DEMO_MODE=false

# PayPal REST app (developer.paypal.com -> Apps & Credentials). sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Morning / Green Invoice API key (see greeninvoice.co.il/help-center/api). sandbox | production
MORNING_ENV=sandbox
MORNING_CLIENT_ID=
MORNING_CLIENT_SECRET=

# Optional: e-mails through resend.com (confirmation to guest + alert to the hostel)
RESEND_API_KEY=
MAIL_FROM=Bethel Hostel <booking@bethel-hostel.com>

# Set on Railway: enables the http -> https redirect
# NODE_ENV=production
