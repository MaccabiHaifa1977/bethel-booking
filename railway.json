{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPaths": ["src/", "server.js", "package.json"],
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "node server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyMaxRetries": 5
  }
}
