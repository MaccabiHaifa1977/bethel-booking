{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "heroku.buildpacks"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node server.js",
    "healthchecks": {
      "readiness": {
        "path": "/",
        "interval": 10,
        "timeout": 5
      }
    }
  }
}
